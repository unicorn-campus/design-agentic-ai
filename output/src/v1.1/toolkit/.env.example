# 비밀값 예시 파일 — **키 이름만** 둠. 실제 값은 각자 환경의 `.env`에 채우고 저장소에 올리지 않음.
# 값의 출처는 README의 「설정 값 표」에 적어 둠. 시간 상한·재시도는 여기 없음(③ 소유 · common 몫).

# --- 대역·실물 구분 (값의 주인은 ② 논리아키텍처 4절) ---
# 예: {"C-2":"live","C-3":"live","C-4":"live","C-7":"live","C-8":"mock","C-9":"mock","C-12":"mock"}
LUNCHPICK_CONNECTOR_MODE=

# --- 주소 · 경로 · 판본 · 인증 헤더 이름 (실물 모드 커넥터만 필요) ---
# 커넥터 식별자 → {base_url, path, method, api_version, auth_header,
#                 secondary_auth_header, idempotency_header}
LUNCHPICK_CONNECTOR_ENDPOINT=

# --- 호출 상한 자리 (실제로 세는 코드는 05-guardrail 몫) ---
LUNCHPICK_CONNECTOR_MAX_CALLS=

# --- 중복 방지 키 보관 기간(시간) · 되묻기 확정값 24 ---
LUNCHPICK_IDEMPOTENCY_TTL_HOURS=

# --- 비밀값 (⑦ 배포설계 6절 항목 이름과 1:1) ---
# ⑦ K-09 지도 API 키 — C-4
LUNCHPICK_MAP_API_KEY=
# ⑦ K-10 날씨 API 키 — C-7
LUNCHPICK_WEATHER_API_KEY=
# ⑦ K-11 식약처 공공 API 인증키 — C-8. **대역 판에는 주입하지 않음**
LUNCHPICK_MFDS_API_KEY=
# ⑦ K-12 PG 가맹점 자격 2항목 — C-9 · C-12. 대역 판에는 시험용 자격만
LUNCHPICK_PG_MERCHANT_ID=
LUNCHPICK_PG_API_SECRET=

# --- 모델 API 열쇠는 common(01-runtime)이 소유함 — 여기 다시 적지 않음 ---
# ⑦ K-01 → LUNCHPICK_LLM_API_KEY (common/.env.example 참조)
