# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_PROJECT_ENVIRONMENT=/opt/lunchpick-venv \
    UV_LINK_MODE=copy
WORKDIR /build

RUN python -m pip install --no-cache-dir uv==0.9.26
COPY services/pyproject.toml services/uv.lock ./services/
RUN cd services && uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim AS runtime

ARG APP_PORT
ENV PATH=/opt/lunchpick-venv/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LUNCHPICK_SERVICE_PORT=${APP_PORT}

RUN groupadd --system --gid 10001 lunchpick \
    && useradd --system --uid 10001 --gid lunchpick --home-dir /nonexistent lunchpick
WORKDIR /app
COPY --from=builder /opt/lunchpick-venv /opt/lunchpick-venv
COPY --chown=lunchpick:lunchpick common ./common
COPY --chown=lunchpick:lunchpick toolkit ./toolkit
COPY --chown=lunchpick:lunchpick services ./services
COPY --chown=lunchpick:lunchpick deploy ./deploy

USER 10001:10001
EXPOSE ${APP_PORT}

CMD ["sh", "-c", "exec uvicorn services.api.main:app --host 0.0.0.0 --port ${LUNCHPICK_SERVICE_PORT:?LUNCHPICK_SERVICE_PORT is required}"]
