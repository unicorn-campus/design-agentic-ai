# 비밀값 예시 파일 — 키 이름만 둠. 값은 각자 환경의 `.env`에 채우고 저장소에 올리지 않음.
# 값의 출처는 README의 「설정 값 표」에 적어 둠.

# --- 단계 상한 (③ 패턴/시퀀스 소유) ---
LUNCHPICK_STEP_TIMEOUT_MS=
LUNCHPICK_STEP_RETRY_COUNT=
LUNCHPICK_STEP_BACKOFF_MS=
LUNCHPICK_STEP_RETRY_CONDITIONAL=

# --- 마감선 예산 (③ 패턴/시퀀스 소유) ---
LUNCHPICK_BUDGET_TOTAL_MS=
LUNCHPICK_BUDGET_LANDING_MS=

# --- 반복 상한 (③ 8-2절 소유) ---
LUNCHPICK_LOOP_MAX_ITER=

# --- 비용 상한 (① 목표/품질 카드 소유) ---
LUNCHPICK_COST_LIMIT_KRW_PER_REQUEST=

# --- 모델 (④ 역할계약서 소유) ---
LUNCHPICK_LLM_PROVIDER=
LUNCHPICK_LLM_MODEL=
LUNCHPICK_LLM_API_KEY=
LUNCHPICK_LLM_THINKING=
LUNCHPICK_LLM_EFFORT=
LUNCHPICK_LLM_MAX_OUTPUT_TOKENS=
LUNCHPICK_LLM_BASE_URL=
LUNCHPICK_EMBEDDING_MODEL=

# --- 중간 저장 장치 (D-08) ---
LUNCHPICK_CHECKPOINT_BACKEND=
LUNCHPICK_CHECKPOINT_DB_URL=
LUNCHPICK_CHECKPOINT_FAILURE_POLICY=
LUNCHPICK_CHECKPOINT_RETENTION_DAYS=

# --- 관측 (D-11) ---
LUNCHPICK_OTLP_ENDPOINT=

# --- 데이터 준비: 행 수 상한 (⑤ 3절 「정형 접근 경로」 소유) ---
# 아래 JSON을 그대로 채움. ⑤가 3칸을 준 행은 부분 합을 씀 —
#   T-3: 최신 1행 · 이력 조회 100행 → 100
#   T-9: Top 5 + 추이 12 + 빈도 20 → 37
#   T-13: 요일 7 + 시간대 5 + 누적 1 → 13
# {"T-1":1,"T-2":1,"T-3":100,"T-4":50,"T-5":100,"T-6":1000,"T-7":1,"T-8":200,"T-9":37,
#  "T-10":1,"T-11":1,"T-12":1,"T-13":13,"T-14":10,"T-15":1,"T-16":500,"T-17":2,"T-18":3}
LUNCHPICK_DATASET_ROW_CAP=

# --- 데이터 준비: 원천 접속 (값의 주인은 도구 연동·배포. 여기서 정하지 않음) ---
# ⑦ 비밀값 K-02 관계형 접속정보 · K-05 벡터 인덱스 · K-06 캐시에 대응함
LUNCHPICK_DATASET_SOURCE_DB_URL=
LUNCHPICK_DATASET_VECTOR_INDEX_URL=
LUNCHPICK_DATASET_CACHE_URL=

# --- 데이터 준비: 미리 짠 조회문 (물리 표·열 이름이 정해진 뒤에 채움) ---
# 경로 식별자 → 조회문. 조회문으로 시작해야 하고 `%(row_cap)s` 자리가 반드시 있어야 함
LUNCHPICK_DATASET_PHYSICAL_QUERY=

# --- 데이터 준비: 합성 시드 ---
LUNCHPICK_DATASET_SEED=
LUNCHPICK_DATASET_SEED_ROWS=

# --- 데이터 준비: 스냅샷·품질 (보존 기간·문턱의 주인은 ⑤) ---
LUNCHPICK_DATASET_SNAPSHOT_DIR=
LUNCHPICK_DATASET_SNAPSHOT_RETENTION_DAYS=
LUNCHPICK_DATASET_QUALITY_THRESHOLD=
LUNCHPICK_DATASET_GLOSSARY_DIR=

# --- 지식 경로: 색인 (⑤ 5절 K-1 「인덱스명」 소유) ---
# {"pref_vector":"pref_vector_idx","food_item":"food_item_idx"}
LUNCHPICK_KNOWLEDGE_INDEX_NAME=
# 색인을 다시 만들 때 붙일 접미. 되묻기 1 — 새 이름으로 만들고 다 되면 갈아 끼움
LUNCHPICK_KNOWLEDGE_INDEX_BUILD_SUFFIX=
LUNCHPICK_KNOWLEDGE_CORPUS_SCOPE=
# ⑤ K-1이 확정 불가로 남긴 칸 — [확인필요: 음식 카드 마스터 구축 주체·건수·태그 분류 체계]
LUNCHPICK_KNOWLEDGE_CORPUS_AS_OF=
# ⑤ K-1은 「해당 없음 — 항목 1건 = 벡터 1건」임. 크기·겹침 설정을 만들지 않았음
LUNCHPICK_KNOWLEDGE_CHUNKING=
# [확인필요: 벡터 인덱스 제품·임베딩 모델명·버전] — 모델 이름은 LUNCHPICK_EMBEDDING_MODEL에 있음
LUNCHPICK_KNOWLEDGE_EMBEDDING_MODEL_VERSION=
LUNCHPICK_KNOWLEDGE_VECTOR_INDEX_PRODUCT=

# --- 지식 경로: 검색·재정렬 (⑤ 5절 K-1 소유) ---
LUNCHPICK_KNOWLEDGE_SEARCH_MODE=
# ⑤ K-1 top-k = 30
LUNCHPICK_KNOWLEDGE_TOP_K=
LUNCHPICK_KNOWLEDGE_RERANK_ENABLED=
# [확인필요: 재정렬 가중치] — ⑤ K-1에 축 4개는 있고 가중치가 없음. 비우면 순서를 바꾸지 않음
# {"preference_similarity":0,"distance":0,"repeat_avoidance":0,"confidence":0}
LUNCHPICK_KNOWLEDGE_RERANK_WEIGHTS=
# ⑤ K-1 「최종 3건만 확정」
LUNCHPICK_KNOWLEDGE_RERANK_KEEP=
# ④ 5-3절 메타데이터 필터 키 4축 — 이름의 주인은 ④임
# ["category_code","distance_m","business_status","visited_within_3days"]
LUNCHPICK_KNOWLEDGE_METADATA_FILTER_KEYS=

# --- 지식 경로: 속성 필터 (⑤ 5절 K-2 소유) ---
# 축 → 성립 여부. ⑤가 「부분 성립」이라 적은 축은 그 문장을 그대로 채움
LUNCHPICK_KNOWLEDGE_ATTRIBUTE_AXES=
LUNCHPICK_KNOWLEDGE_RADIUS_M=
LUNCHPICK_KNOWLEDGE_SORT_PRIMARY=

# --- 지식 경로: 용어사전 적용 지점 (⑤ 5절 K-3 소유) ---
LUNCHPICK_KNOWLEDGE_GLOSSARY_APPLY_POINTS=
LUNCHPICK_KNOWLEDGE_QUERY_EXPANSION_ENABLED=

# --- 지식 경로: 되묻기로 정한 값 (설계서 ⑤에 되돌려 적어야 함) ---
LUNCHPICK_KNOWLEDGE_RESULT_MERGE=
# 비우면 검색 결과를 잠시 저장하지 않음(되묻기 4 기본값)
LUNCHPICK_KNOWLEDGE_RESULT_CACHE_TTL_S=
LUNCHPICK_KNOWLEDGE_LOW_CONFIDENCE_SIGNAL=
