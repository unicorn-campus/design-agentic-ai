# 런치픽 로컬 실행 환경변수 — 커밋 금지(.gitignore 처리됨)
# ⑦ 4-2절 비밀값 표 K-1 ~ K-13 대응

# K-1 LLM API 키(E-1) — I-2 추천 이미지만
ANTHROPIC_API_KEY=sk-ant-...
LP_LLM_MODEL=claude-sonnet-5
LP_LLM_MODE=real

# K-2 지도·식당 API 키(E-2) — I-5 SYNC · I-2 길찾기
GOOGLE_PLACES_API_KEY=
LP_PLACES_MODE=mock

# K-3 날씨 API 키(E-3) — I-2
OPENWEATHER_API_KEY=
LP_WEATHER_MODE=mock

# K-4 카카오 로그인 클라이언트 시크릿(E-4) — I-3 (로컬은 Mock)
KAKAO_CLIENT_SECRET=local-mock-not-a-real-secret
LP_KAKAO_MODE=mock

# K-5 알레르기 전용 암호화 키 — I-2 · I-3 두 곳만(⑦ 4-4)
LP_ALLERGEN_KEY=bG9jYWwtYWxsZXJnZW4ta2V5LTMyYnl0ZXMtZGVtby0x
# K-6 개인정보 저장 암호화 키 — K-5와 다른 키
LP_PII_KEY=bG9jYWwtcGlpLWtleS0zMmJ5dGVzLWRlbW8tMDAwMDAwMDA

# K-7 ~ K-12 저장소 접속정보 — 이미지별 다른 계정(읽기전용 분리)
LP_DB_HOST=lp-postgres
LP_DB_PORT=5432
LP_DB_NAME=lunchpick
LP_DB_RW_USER=lp_rw
LP_DB_RW_PASSWORD=lp_rw_local
LP_DB_RO_USER=lp_ro
LP_DB_RO_PASSWORD=lp_ro_local
LP_DB_OBS_USER=lp_obs
LP_DB_OBS_PASSWORD=lp_obs_local

# K-13 JWT 서명 키(서명은 I-3만) / 검증 키
LP_JWT_SECRET=local-jwt-signing-secret-do-not-reuse
LP_JWT_TTL_SEC=3600

# K-14 푸시 벤더 자격증명(E-6) — I-2
LP_PUSH_MODE=mock

# K-17 결제 GW 키(E-5) — 해당 없음(Mock 확정, ② 6절)

# S-R10 타임아웃 덮어쓰기 — 비우면 ④ 설계값 1,200ms를 씀.
# 실측 약 5,200ms이므로 실물 C-1 경로를 보려면 8000 정도가 필요함.
# 단, 덮어쓰면 ① Q-1 `p95 3초`가 성립하지 않음(기동 로그에 경고가 남음).
LP_SR10_TIMEOUT_MS=
