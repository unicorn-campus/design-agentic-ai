# 품질평가 프로그램 설정 보기. 이 파일을 .env로 복사해 필요한 값만 채움
# 읽는 순서: 환경변수 → 이 폴더의 .env → hybrid-ai-lab/.env (앞이 우선)
# 비밀값은 이 파일에 적지 않음. .env는 Git에 올리지 않음

# --- 다른 프로그램 위치(비우면 hybrid-ai-lab 안의 기본 위치) ---
# INDEXER_DIR=../indexer/vector-bm25
# RETRIEVER_DIR=../retriever/vector-retriever
# DATA_ROOT=../indexer/vector-bm25/data

# --- RAGAS 평가자 ---
OLLAMA_BASE_URL=http://localhost:11434/v1
JUDGE_LOCAL_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M
JUDGE_ANTHROPIC_MODEL=claude-opus-5-5
JUDGE_GROQ_MODEL=openai/gpt-oss-120b
# API 평가자 비밀키는 hybrid-ai-lab/.env의 CLAUDE_API_KEY · GROQ_API_KEY를 그대로 씀
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# 동시 채점 수 — 로컬 평가자는 GPU 하나를 나눠 써서 크게 늘려도 빨라지지 않음
RAGAS_CONCURRENCY=4
RAGAS_MAX_TOKENS=2048

# --- 임베딩(AnswerRelevancy) — 색인과 같은 모델 · revision ---
EMBED_MODEL=nlpai-lab/KURE-v2
EMBED_REVISION=3431f86d399d666083890dbb882aced6708873bc
EMBED_DEVICE=auto
HF_LOCAL_FILES_ONLY=true

# --- 실행기 ---
# 실험 중 꺼져 있어야 하는 검색 API 서버 주소(쉼표로 여러 개)
RETRIEVER_API_URLS=http://127.0.0.1:8020
# 하위 프로세스 시간 상한(초) — 근거가 없어 기본은 없음(결정 필요)
# PROCESS_TIMEOUT_SECONDS=
