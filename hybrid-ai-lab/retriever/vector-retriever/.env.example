# 문서 검색 리트리버(W-2) 설정 보기. 이 파일을 .env로 복사해 값을 채움
# 읽는 순서: 이 폴더의 .env → hybrid-ai-lab/.env → 환경변수(환경변수가 가장 우선)
# 비밀값은 이 파일에 적지 않음. .env는 Git에 올리지 않음

# --- 색인·로그 경로 (상대 경로는 이 폴더 기준으로 해석됨) ---
DATA_ROOT=../../indexer/vector-bm25/data
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Groq LLM (C-01 질문 분석 · C-02 다음 행동 · C-04 답변 생성) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# --- Claude LLM (C-03 질문 변환만) ---
# ANTHROPIC_API_KEY가 없으면 CLAUDE_API_KEY를 씀(공용 hybrid-ai-lab/.env 이름)
ANTHROPIC_API_KEY=
# CLAUDE_EFFORT 같은 이름은 Claude Code가 이미 쓰므로 C03_ 접두어를 씀
C03_MODEL=claude-opus-5-5
C03_EFFORT=low
C03_MAX_TOKENS=4000

# --- 임베딩 모델 (색인과 같은 모델·revision이어야 함) ---
EMBED_MODEL=nlpai-lab/KURE-v2
EMBED_REVISION=3431f86d399d666083890dbb882aced6708873bc
EMBED_DEVICE=auto
EMBED_MAX_TOKENS=800
EMBED_DIMENSION=768
# 참이면 모델 파일을 내려받지 않고 로컬 캐시만 씀
HF_LOCAL_FILES_ONLY=true

# --- 리랭커 모델 ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# 질문 + 조각(최대 800토큰)을 한 번에 읽도록 1024로 둠. 512면 조각 뒤쪽 정답 문장이 잘려 점수가 떨어짐(실측)
RERANK_MAX_LENGTH=1024

# --- 커넥터 타임아웃(초) ---
TIMEOUT_C01=2.5
TIMEOUT_C02=1.5
# C-03은 Claude Opus 5.5라 1회 중앙 3.6초·최대 7.1초(실측 22회). 설계 1.2초에서 8.0초로 바꿈
TIMEOUT_C03=8.0
TIMEOUT_C04=2.5

# --- 시간 예산·반복 상한 ---
# C-03 변경으로 설계 30초에서 45초로 늘림
TIME_BUDGET_SECONDS=45
CLOSING_SECONDS=1.5
START_THRESHOLD_SECONDS=1.5
MAX_TURNS=6
MAX_LLM_CALLS=16
MAX_REWRITES=2

# --- 검색 결과 채점 기준 (평가셋 검증 후 조정 대상) ---
GRADE_UPPER=0.7
GRADE_LOWER=0.3
GRADE_MIN_GAP=0.05
GRADE_MIN_OVERLAP=1
# 1위 리랭크 점수가 이 값 이상이면 벡터·BM25 겹침이 0이어도 합의로 봄
GRADE_OVERLAP_WAIVER=0.9

# --- 하이브리드 합치기·핵심어 ---
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
KEYWORD_MAX_DF_RATIO=0.1
# C-01이 잡담이라 해도 조각의 이 비율 이상에 나오는 업무 명사가 있으면 단순 질문으로 처리
DOMAIN_TERM_MIN_DF_RATIO=0.2

# --- API 서버 ---
API_HOST=127.0.0.1
API_PORT=8020
