# 실제 값은 ../../.env (hybrid-ai-lab/.env)에 설정합니다.
GROQ_API_KEY=
# 선택: groq, gemma. 기본값은 groq입니다.
SQL_RETRIEVER_LLM_PROVIDER=groq
SQL_RETRIEVER_GROQ_MODEL=openai/gpt-oss-120b
SQL_RETRIEVER_GEMMA_MODEL=hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
SQL_RETRIEVER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 로컬 Gemma의 실행 런타임을 선택합니다: ollama 또는 vllm
SQL_RETRIEVER_LLM_RUNTIME=ollama
SQL_RETRIEVER_VLLM_BASE_URL=http://127.0.0.1:8000/v1
SQL_RETRIEVER_VLLM_MODEL=gemma-4-12b-it
SQL_RETRIEVER_VLLM_API_KEY=
SQL_RETRIEVER_VLLM_MAX_TOKENS=1024
# 선택: 미설정 시 공통 실습 PostgreSQL과 lab_user를 사용합니다.
SQL_RETRIEVER_DB_DSN=host=localhost port=5432 dbname=cardlab user=sql_retriever_user
SQL_RETRIEVER_DB_PASSWORD=
SQL_RETRIEVER_STATEMENT_TIMEOUT_MS=5000
SQL_RETRIEVER_LLM_TIMEOUT_SECONDS=30
SQL_RETRIEVER_MAX_TOKENS=2500
SQL_RETRIEVER_PORT=8012
