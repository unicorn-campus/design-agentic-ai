        }
      ],
      "additional_properties": false
    },
    {
      "label": "Clause",
      "description": "(\uc870\ud56d) \ud574\ub2f9: \ubcf8\ubb38\uc5d0 \uc870\ubb38 \ub0b4\uc6a9(\u2460, \u2461 \uac19\uc740 \ud56d)\uc774 \ud568\uaed8 \uc801\ud78c '\uc81cN\uc870(\uc81c\ubaa9)' \ud558\ub098. \ube44\ud574\ub2f9: \ucc28\ub840(\ubaa9\ucc28)\uc5d0 \uc81c\ubaa9\ub9cc \ub098\uc5f4\ub41c \uc870\ud56d, \uc870\ud56d \uc548\uc758 \ud56d\uc774\ub098 \ud638, \uc57d\uad00 \ubb38\uc11c \uc804\uccb4",
      "properties": [
        {
          "name": "clause_no",
          "type": "STRING",
          "description": "\uc870\ud56d \ubc88\ud638(\uc608: \uc81c16\uc870\uc7582)",
          "required": false
        },
        {
          "name": "title",
          "type": "STRING",
          "description": "\uc870\ud56d \uc81c\ubaa9(\uad04\ud638 \uc548 \uae00\uc790)",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Requirement",
      "description": "(\ucda9\uc871 \uc870\uac74) \ud574\ub2f9: \ubb34\uc5c7\uc744 \ubc1b\uac70\ub098 \ud560 \uc218 \uc788\ub294\uc9c0\uac00 \uac08\ub9ac\ub294 \uae30\uc900. \ubcf4\ud1b5 \uc22b\uc790(\uae08\uc561, \uc77c\uc218, \ud69f\uc218, \ube44\uc728)\ub098 '~\uc774\uc0c1', '~\uc778 \uacbd\uc6b0\uc5d0\ub9cc', '~\uc744 \ubaa8\ub450 \ucda9\uc871\ud560 \ub54c \uc81c\uacf5', '~\ud558\uba74 \ubc1b\uc744 \uc218 \uc788\uc74c' \uaf34\uc784(\uc608: \uc9c1\uc804 12\uac1c\uc6d4 \uc774\uc6a9\uae08\uc561\uc774 300\ub9cc \uc6d0 \uc774\uc0c1\uc774\uba74 \uba74\uc81c, \uc804\uc6d4 \uc774\uc6a9\uae08\uc561\uacfc \uc6d4 \ud55c\ub3c4\ub97c \ubaa8\ub450 \ucda9\uc871\ud560 \ub54c \uc81c\uacf5). \ube44\ud574\ub2f9: \uc0c1\ud669\uc744 \uba3c\uc800 \ub9d0\ud558\uace0 \uadf8\ub54c\uc758 \ucc98\ub9ac\ub97c \uc815\ud55c \ubb38\uc7a5(Handling\uc5d0 \uc500, \uc608: \uacc4\uc57d\uc774 \ucde8\uc18c\ub41c \uacbd\uc6b0 \uc9c0\uae09 \ubcf4\ub958\ub97c \uc694\uccad\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4, \uc778\uc99d \uc2e4\ud328\uac00 \uac10\uc9c0\ub418\uba74 \uc815\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4), \ub204\uac00 \ubb34\uc5c7\uc744 \ud55c\ub2e4\ub294 \uc77c\ubc18 \uc758\ubb34\ub098 \uc808\ucc28(\uc608: \ubcf8\uc778 \ud655\uc778 \ud6c4 \uc804\ub2ec\ud569\ub2c8\ub2e4, \ud68c\uc6d0\uc774 \uc9c1\uc811 \uc785\ub825\ud569\ub2c8\ub2e4, \uba85\uc138\uc11c\uc5d0 \ud45c\uc2dc\ud569\ub2c8\ub2e4, \ud568\uaed8 \uae30\ub85d\ud569\ub2c8\ub2e4, \uc808\ucc28\ub97c \uc801\uc6a9\ud569\ub2c8\ub2e4), \uae30\ud55c\ub9cc \uc815\ud55c \ubb38\uc7a5",
      "properties": [
        {
          "name": "description",
          "type": "STRING",
          "description": "\uc870\uac74 \ubb38\uc7a5(\uc6d0\ubb38 \uadf8\ub300\ub85c)",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Deadline",
      "description": "(\uae30\ud55c\uacfc \ud1b5\uc9c0 \uc2dc\uc810) \ud574\ub2f9: \ubb34\uc5c7\uc744 \ud574\uc57c \ud558\ub294 \uae30\ud55c\uc774\ub098 \uc2dc\uc810(\uc608: ~\uc77c \uc774\ub0b4, \uc989\uc2dc, \ub2e4\uc74c \uc601\uc5c5\uc77c, ~\uae4c\uc9c0, ~\ud55c \uc2dc\uc810\ubd80\ud130, 1\ub144 \ub2e8\uc704\ub85c), \ubbf8\ub9ac \uc54c\ub9ac\ub294 \uc2dc\uc810(\uc608: \uc0ac\uc804\uc5d0 \uc548\ub0b4, \uccad\uad6c \uc804\uc5d0 \uc548\ub0b4, ~\uc77c \uc804\uc5d0 \uc54c\ub9bc, \uc885\ub8cc\uc77c 30\uc77c \uc804\ubd80\ud130). \uc0c1\ud669 \uc870\uac74\uc774 \ubd99\uc740 \ubb38\uc7a5\uc774\uc5b4\ub3c4 \uc2dc\uc810\uc774 \uc788\uc73c\uba74 \ud574\ub2f9\ud558\uba70 \uac19\uc740 \ubb38\uc7a5\uc744 Handling\uc5d0\ub3c4 \ub458 \uc218 \uc788\uc74c. \ube44\ud574\ub2f9: \uc2dc\uc810 \uc5c6\uc774 '\uc54c\ub9bd\ub2c8\ub2e4', '\uc548\ub0b4\ud569\ub2c8\ub2e4'\ub9cc \uc788\ub294 \ubb38\uc7a5(\uc608: \ucc98\ub9ac \uacb0\uacfc\ub97c \uc54c\ub9bd\ub2c8\ub2e4), \ucc98\ub9ac \ubc29\ubc95, \uae08\uc561 \uc870\uac74. \uc870\ud56d\uc5d0 \uae30\ud55c\uc774\ub098 \uc2dc\uc810\uc774 \uc5ec\ub7ec \uac1c \uc788\uc73c\uba74 \uc2dc\uc810\ub9c8\ub2e4 Deadline \ub178\ub4dc\ub97c \ud558\ub098\uc529 \ub9cc\ub4e4\uace0 SETS_DEADLINE\uc73c\ub85c \uc870\ud56d\uc5d0 \uc774\uc74c. \uc870\ud56d\uc5d0\uc11c '\uc804\uc5d0, \uc774\ub0b4, \ubd80\ud130, \uc989\uc2dc, \ub2e4\uc74c \uc601\uc5c5\uc77c, \ud6c4\uc5d0\ub294, \uacb0\uc81c\uc77c\uc5d0, \uc0ac\uc804\uc5d0' \uac19\uc740 \uc2dc\uc810 \ub0b1\ub9d0\uc774 \ub4e0 \ubb38\uc7a5\uc740 \ud558\ub098\ub3c4 \ube60\ub728\ub9ac\uc9c0 \ub9d0\uace0 \ubaa8\ub450 Deadline\uc73c\ub85c \ubf51\uc74c",
      "properties": [
        {
          "name": "description",
          "type": "STRING",
          "description": "\uae30\ud55c\uc774\ub098 \uc2dc\uc810\uc774 \ub4e0 \ubb38\uc7a5 \uc804\uccb4(\uc6d0\ubb38 \uadf8\ub300\ub85c). \uc2dc\uc810 \ub0b1\ub9d0 \uc870\uac01\ub9cc \uc4f0\uc9c0 \uc54a\uc74c(\uc608: '\uccad\uad6c \uc804\uc5d0'\uac00 \uc544\ub2c8\ub77c '\uc7a5\uae30\uac04 \uc774\uc6a9\ud558\uc9c0 \uc54a\uc740 \uce74\ub4dc\uc758 \ucc28\uae30 \uc5f0\ud68c\ube44\ub294 \uccad\uad6c \uc804\uc5d0 \ud68c\uc6d0\uc5d0\uac8c \uc548\ub0b4\ud569\ub2c8\ub2e4.')",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Handling",
      "description": "(\uc0c1\ud669\ubcc4 \ucc98\ub9ac) \ud574\ub2f9: '~\uc774\uba74, ~\ud558\uba74, ~\uacbd\uc6b0'\ucc98\ub7fc \uc0c1\ud669\uc744 \uba3c\uc800 \ub9d0\ud558\uace0 \uadf8\ub54c\uc758 \ucc98\ub9ac\ub97c \uc815\ud55c \ubb38\uc7a5(\uc608: \uacb0\uc81c\uc77c\uc774 \ud734\uc77c\uc774\uba74 \ub2e4\uc74c \uc601\uc5c5\uc77c\uc5d0 \ucd9c\uae08, \uc624\ub798 \uc4f0\uc9c0 \uc54a\uc740 \uce74\ub4dc\ub294 \uc774\uc6a9\uc744 \uc815\uc9c0). \ucc98\ub9ac \uc2dc\uc810\uc774 \ud568\uaed8 \uc801\ud600 \uc788\uc5b4\ub3c4 \uc0c1\ud669\uc774 \uc55e\uc5d0 \uc788\uc73c\uba74 \uc5ec\uae30\uc5d0 \uc500. \ube44\ud574\ub2f9: \uc0c1\ud669 \uc5c6\uc774 \uae30\ud55c\ub9cc \uc815\ud55c \ubb38\uc7a5, \ucc98\ub9ac\ub97c \ubc1b\uae30 \uc704\ud55c \uae08\uc561 \uc870\uac74",
      "properties": [
        {
          "name": "situation",
          "type": "STRING",
          "description": "\uc0c1\ud669(\uc6d0\ubb38 \uadf8\ub300\ub85c)",
          "required": false
        },
        {
          "name": "action",
          "type": "STRING",
          "description": "\uadf8\ub54c\uc758 \ucc98\ub9ac(\uc6d0\ubb38 \uadf8\ub300\ub85c)",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Topic",
      "description": "(\uc8fc\uc81c) \ud574\ub2f9: \uc870\ud56d\uc774\ub098 \ubd88\ub9cc\uc774 \ub2e4\ub8e8\ub294 \uc5c5\ubb34 \uc8fc\uc81c \ud558\ub098. \uc774\ub984\uc740 \uc544\ub798 \ub300\ud45c \uc774\ub984 \ubaa9\ub85d\uc5d0\uc11c\ub9cc \uace0\ub984(\uac01 \uc774\ub984 \ub4a4\ub294 \ub73b). \ubd88\ub9cc\uc5d0 \ubd99\uc77c \ub54c\ub294 \ubd88\ub9cc\uc758 \uc6d0\uc778\uc774 \ub41c \ub300\uc0c1\uc73c\ub85c \uace0\ub974\uace0, \uc0c1\ub2f4\uc774 \uc77c\uc5b4\ub09c \uc7a5\uba74(\uba85\uc138\uc11c\ub97c \ubcf4\uba70 \ud1b5\ud654, \uc571 \ud654\uba74 \ud655\uc778 \ub4f1)\uc73c\ub85c \uace0\ub974\uc9c0 \uc54a\uc74c(\uc608: \ud61c\ud0dd \uc870\uac74\uc774 \ubd88\ub9cc\uc774\uba74 \uba85\uc138\uc11c\ub97c \ubcf4\uba70 \ub9d0\ud588\uc5b4\ub3c4 '\ubd80\uac00\uc11c\ube44\uc2a4\uc640 \ud3ec\uc778\ud2b8'). \ubaa9\ub85d: \uc5f0\ud68c\ube44: \uc5f0\ud68c\ube44\ub97c \ub9e4\uae30\uace0 \uba74\uc81c\ud558\uac70\ub098 \ub3cc\ub824\uc8fc\ub294 \uc77c; \ubd80\uac00\uc11c\ube44\uc2a4\uc640 \ud3ec\uc778\ud2b8: \ud560\uc778, \uc801\ub9bd, \uce90\uc2dc\ubc31 \uac19\uc740 \ubd80\uac00\uc11c\ube44\uc2a4\uc640 \ud3ec\uc778\ud2b8\ub97c \ubc1b\ub294 \uc870\uac74, \uc2e0\uccad, \uc801\uc6a9 \ub300\uc0c1; \ubcf8\uc778 \uc778\uc99d\uacfc \ubcf4\uc548: \ubcf8\uc778 \ud655\uc778, \uc778\uc99d \uc808\ucc28, \ube44\ubc00\ubc88\ud638, \uce74\ub4dc\uc640 \uc778\uc99d\uc218\ub2e8 \ubcf4\uad00; \ud1b5\uc9c0\uc640 \uad11\uace0: \uce74\ub4dc\uc0ac\uac00 \ud68c\uc6d0\uc5d0\uac8c \uc54c\ub9ac\ub294 \ubc29\ubc95\uacfc \uad11\uace0, \ud310\ucd09 \uc54c\ub9bc; \ubbfc\uc6d0\uacfc \uc774\uc758 \ucc98\ub9ac: \ubbfc\uc6d0, \uc774\uc758\uc2e0\uccad, \ub2e4\ud23c\uc758 \uc811\uc218\uc640 \ucc98\ub9ac \uacbd\uacfc \uc124\uba85; \uba85\uc138\uc11c\uc640 \uacb0\uc81c: \uc774\uc6a9\ub300\uae08 \uba85\uc138\uc11c, \uacb0\uc81c\uc77c\uacfc \ucd9c\uae08, \ub0a9\ubd80, \ucde8\uc18c\uc640 \ud658\ubd88\uc758 \ubc18\uc601; \ud560\ubd80: \ud560\ubd80 \uac70\ub798\uc640 \uadf8 \ucca0\ud68c, \ud56d\ubcc0; \ubd84\uc2e4\uacfc \ubd80\uc815 \uc0ac\uc6a9: \ubd84\uc2e4, \ub3c4\ub09c, \uc758\uc2ec \ubb38\uc790, \ubcf8\uc778\uc774 \ud558\uc9c0 \uc54a\uc740 \uac70\ub798; \uc774\uc6a9\uc815\uc9c0\uc640 \ud734\uba74: \uce74\ub4dc \uc774\uc6a9\uc815\uc9c0\uc640 \ud574\uc81c, \uc624\ub798 \uc4f0\uc9c0 \uc54a\uc740 \uce74\ub4dc; \ud574\uc9c0: \ud68c\uc6d0\uc774\ub098 \uce74\ub4dc\uc0ac\uc758 \uacc4\uc57d \ud574\uc9c0, \ub2e4\ub978 \uce74\ub4dc\uc0ac\ub85c \uc62e\uae30\uae30; \ubc1c\uae09\uacfc \uce74\ub4dc \uad00\ub9ac: \uce74\ub4dc \ubc1c\uae09, \uac00\uc871\uce74\ub4dc, \uc804\ub2ec, \uac31\uc2e0, \uc5ec\ub7ec \uc7a5 \ubcf4\uc720 \uc815\ub9ac; \uac1c\uc778\uc815\ubcf4\uc640 \ud68c\uc6d0 \uc815\ubcf4: \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac, \uc8fc\uc18c\ub098 \uc5f0\ub77d\ucc98 \uac19\uc740 \ud68c\uc6d0 \uc815\ubcf4 \ubcc0\uacbd; \ud574\uc678 \uc774\uc6a9: \ud574\uc678 \uacb0\uc81c\uc640 \ud574\uc678 \uc774\uc6a9 \uc218\uc218\ub8cc, \uc6d0\ud654\uacb0\uc81c; \uce74\ub4dc\ub300\ucd9c\uacfc \uae08\ub9ac: \uce74\ub4dc\ub300\ucd9c, \uc5f0\uccb4, \uae08\ub9ac; \uc774\uc6a9\ud55c\ub3c4\uc640 \uc2b9\uc778: \uc774\uc6a9\ud55c\ub3c4, \uc2b9\uc778\uacfc \ucde8\uc18c\uc758 \uc6d0\uce59. \ube44\ud574\ub2f9: \ubaa9\ub85d\uc5d0 \uc5c6\ub294 \uc774\ub984, \uce74\ub4dc \uc774\ub984, \ud61c\ud0dd \uc774\ub984, \uc5c5\uc885 \uc774\ub984",
      "properties": [
        {
          "name": "name",
          "type": "STRING",
          "description": "\uc8fc\uc81c \ub300\ud45c \uc774\ub984. \ubaa9\ub85d\uc758 \uae00\uc790\ub97c \uadf8\ub300\ub85c \uc500",
