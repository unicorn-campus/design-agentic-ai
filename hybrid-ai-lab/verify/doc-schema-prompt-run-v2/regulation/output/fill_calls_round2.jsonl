{"chunk_id": "regulation:제6조의2", "raw_nodes": ["TermsDocument", "Clause", "Requirement", "Handling", "Handling", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_REQUIREMENT", "DEFINES_HANDLING", "DEFINES_HANDLING", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제6조의2:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제6조의2:1", "label": "Clause", "properties": {"clause_no": "제6조의2", "title": "가족카드의 발급과 관리"}}, {"id": "regulation:제6조의2:2", "label": "Requirement", "properties": {"description": "가족회원의 동의를 확인한 뒤"}}, {"id": "regulation:제6조의2:3", "label": "Handling", "properties": {"situation": "본인회원은 가족회원의 동의를 확인한 뒤 가족카드 발급을 신청하며", "action": "카드사는 연회비, 발급 가능 수, 결제 책임과 이용 범위를 사전에 안내합니다."}}, {"id": "regulation:제6조의2:4", "label": "Handling", "properties": {"situation": "본인회원은 가족카드의 한도 감액, 이용정지 또는 해지를 요청할 수 있습니다", "action": "카드사는 처리 결과를 본인회원과 가족회원에게 각각 알립니다."}}, {"id": "regulation:제6조의2:5", "label": "Handling", "properties": {"situation": "가족관계가 변경되거나 가족회원이 사용 중단을 요청하면", "action": "카드사는 본인 확인 후 이용정지와 정산 절차를 진행합니다."}}, {"id": "regulation:제6조의2:6", "label": "Topic", "properties": {"name": "발급과 카드 관리"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제6조의2:0", "end": "regulation:제6조의2:1", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:2", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:3", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:4", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:5", "properties": {}}, {"type": "ABOUT", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:6", "properties": {}}], "seconds": 6.4}
