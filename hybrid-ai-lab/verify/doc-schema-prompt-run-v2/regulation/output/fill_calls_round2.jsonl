{"chunk_id": "regulation:제16조의3", "raw_nodes": ["TermsDocument", "Clause", "Handling", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "DEFINES_HANDLING", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제16조의3:TD1", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제16조의3:C1", "label": "Clause", "properties": {"clause_no": "제16조의3", "title": "할부 거래의 항변 요청"}}, {"id": "regulation:제16조의3:H1", "label": "Handling", "properties": {"situation": "가맹점이 계약을 이행하지 않거나 계약이 취소된 경우", "action": "회원은 남은 할부금의 지급 보류를 요청할 수 있습니다."}}, {"id": "regulation:제16조의3:H2", "label": "Handling", "properties": {"situation": "카드사는 가맹점 확인 자료, 취소 기록과 이미 지급된 회차를 구분하여 심사하고", "action": "보류 범위와 다음 확인 일을 회원에게 알립니다."}}, {"id": "regulation:제16조의3:T1", "label": "Topic", "properties": {"name": "할부"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제16조의3:TD1", "end": "regulation:제16조의3:C1", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조의3:C1", "end": "regulation:제16조의3:H1", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조의3:C1", "end": "regulation:제16조의3:H2", "properties": {}}, {"type": "ABOUT", "start": "regulation:제16조의3:C1", "end": "regulation:제16조의3:T1", "properties": {}}], "seconds": 4.2}
