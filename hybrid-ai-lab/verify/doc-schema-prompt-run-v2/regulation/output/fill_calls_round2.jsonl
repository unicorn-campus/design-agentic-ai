{"chunk_id": "regulation:제10조", "raw_nodes": ["TermsDocument", "Clause", "Requirement", "Topic", "Deadline", "Handling", "Deadline", "Handling", "Deadline"], "raw_rels": ["HAS_CLAUSE", "SETS_REQUIREMENT", "ABOUT", "SETS_DEADLINE", "SETS_DEADLINE", "SETS_DEADLINE", "DEFINES_HANDLING", "DEFINES_HANDLING"], "nodes": [{"id": "regulation:제10조:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제10조:1", "label": "Clause", "properties": {"clause_no": "제10조", "title": "연회비 면제 및 계약 해지에 따른 반환"}}, {"id": "regulation:제10조:2", "label": "Requirement", "properties": {"description": "본인회원의 직전 12개월 이용금액이 3,000,000원 이상이고 다음 연회비 청구일까지 연체가 없으면 다음 연도의 기본 연회비를 전액 면제합니다."}}, {"id": "regulation:제10조:3", "label": "Topic", "properties": {"name": "연회비"}}, {"id": "regulation:제10조:4", "label": "Deadline", "properties": {"description": "다음 연회비 청구 전에"}}, {"id": "regulation:제10조:5", "label": "Handling", "properties": {"situation": "유효기간 전에 계약을 해지하면", "action": "해지 다음 날부터 연회비 기간 종료일까지 남은 일수에 비례하여 반환 기준액을 계산합니다."}}, {"id": "regulation:제10조:6", "label": "Deadline", "properties": {"description": "7영업일 이내"}}, {"id": "regulation:제10조:7", "label": "Handling", "properties": {"situation": "이용내역 조사로 계산이 늦어지면", "action": "지연 사유와 예정일을 알리고 해지일부터 60일 안에 처리합니다."}}, {"id": "regulation:제10조:8", "label": "Deadline", "properties": {"description": "해지일부터 60일 안에"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제10조:0", "end": "regulation:제10조:1", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:2", "properties": {}}, {"type": "ABOUT", "start": "regulation:제10조:1", "end": "regulation:제10조:3", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:4", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:6", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end":