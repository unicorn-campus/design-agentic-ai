{"chunk_id": "regulation:제16조의2", "raw_nodes": ["TermsDocument", "Clause", "Deadline", "Handling", "Handling", "Requirement", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_DEADLINE", "DEFINES_HANDLING", "DEFINES_HANDLING", "SETS_REQUIREMENT", "ABOUT"], "nodes": [{"id": "regulation:제16조의2:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제16조의2:1", "label": "Clause", "properties": {"clause_no": "제16조의2", "title": "할부 거래의 철회 요청"}}, {"id": "regulation:제16조의2:2", "label": "Deadline", "properties": {"description": "7일 이내에 철회를 요청할 수 있습니다."}}, {"id": "regulation:제16조의2:3", "label": "Handling", "properties": {"situation": "회원은 가맹점과 카드사에 거래 식별값, 철회 사유와 반환 상태를 제출", "action": "카드사는 접수 시각과 처리 단계를 기록합니다."}}, {"id": "regulation:제16조의2:4", "label": "Handling", "properties": {"situation": "이미 사용했거나 가치가 현저히 줄어든 상품 등 철회가 제한되는 경우", "action": "제한 사유와 이의신청 방법을 안내합니다."}}, {"id": "regulation:제16조의2:5", "label": "Requirement", "properties": {"description": "이미 사용했거나 가치가 현저히 줄어든 상품 등 철회가 제한되는 경우에는 제한 사유와 이의신청 방법을 안내합니다."}}, {"id": "regulation:제16조의2:6", "label": "Topic", "properties": {"name": "할부"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제16조의2:0", "end": "regulation:제16조의2:1", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:2", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:3", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:4", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:5", "properties": {}}, {"type": "ABOUT", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:6", "properties": {}}], "seconds": 4.4}
