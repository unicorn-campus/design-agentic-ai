{"chunk_id": "regulation:제6조의2", "raw_nodes": ["TermsDocument", "Clause", "Topic", "Handling", "Handling", "Handling"], "raw_rels": ["HAS_CLAUSE", "ABOUT", "DEFINES_HANDLING", "DEFINES_HANDLING", "DEFINES_HANDLING"], "nodes": [{"id": "regulation:제6조의2:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제6조의2:1", "label": "Clause", "properties": {"clause_no": "제6조의2", "title": "가족카드의 발급과 관리"}}, {"id": "regulation:제6조의2:2", "label": "Topic", "properties": {"name": "발급과 카드 관리"}}, {"id": "regulation:제6조의2:3", "label": "Handling", "properties": {"situation": "본인회원은 가족회원의 동의를 확인한 뒤", "action": "가족카드 발급을 신청하며, 카드사는 연회비, 발급 가능 수, 결제 책임과 이용 범위를 사전에 안내합니다."}}, {"id": "regulation:제6조의2:4", "label": "Handling", "properties": {"situation": "본인회원은 가족카드의 한도 감액, 이용정지 또는 해지를 요청할 수 있습니다", "action": "카드사는 처리 결과를 본인회원과 가족회원에게 각각 알립니다."}}, {"id": "regulation:제6조의2:5", "label": "Handling", "properties": {"situation": "가족관계가 변경되거나 가족회원이 사용 중단을 요청하면", "action": "카드사는 본인 확인 후 이용정지와 정산 절차를 진행합니다."}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제6조의2:0", "end": "regulation:제6조의2:1", "properties": {}}, {"type": "ABOUT", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:2", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:3", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:4", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제6조의2:1", "end": "regulation:제6조의2:5", "properties": {}}], "seconds": 4.3}
{"chunk_id": "regulation:제7조", "raw_nodes": ["TermsDocument", "Clause", "Requirement", "Handling", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_REQUIREMENT", "DEFINES_HANDLING", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제7조:TD1", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제7조:C1", "label": "Clause", "properties": {"clause_no": "제7조", "title": "카드의 전달과 수령"}}, {"id": "regulation:제7조:R1", "label": "Requirement", "properties": {"description": "본인 확인 후 전달합니다"}}, {"id": "regulation:제7조:H1", "label": "Handling", "properties": {"situation": "대리 수령 시", "action": "사전에 등록한 절차를 적용합니다"}}, {"id": "regulation:제7조:H2", "label": "Handling", "properties": {"situation": "포장 훼손이나 배송 오류를 발견하면", "action": "카드를 사용하지 않고 고객지원 채널에 신고합니다"}}, {"id": "regulation:제7조:T1", "label": "Topic", "properties": {"name": "발급과 카드 관리"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제7조:TD1", "end": "regulation:제7조:C1", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제7조:C1", "end": "regulation:제7조:R1", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제7조:C1", "end": "regulation:제7조:H1", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제7조:C1", "end": "regulation:제7조:H2", "properties": {}}, {"type": "ABOUT", "start": "regulation:제7조:C1", "end": "regulation:제7조:T1", "properties": {}}], "seconds": 4.8}
{"chunk_id": "regulation:제8조", "raw_nodes": ["TermsDocument", "Clause", "Deadline", "Handling", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_DEADLINE", "DEFINES_HANDLING", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제8조:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제8조:1", "label": "Clause", "properties": {"clause_no": "제8조", "title": "사용 등록"}}, {"id": "regulation:제8조:2", "label": "Deadline", "properties": {"description": "회원이 본인 확인과 사용 등록을 마친 시점부터 결제 기능이 활성화됩니다."}}, {"id": "regulation:제8조:3", "label": "Handling", "properties": {"situation": "회원이 본인 확인과 사용 등록을 마친 시점부터", "action": "결제 기능이 활성화됩니다."}}, {"id": "regulation:제8조:4", "label": "Handling", "properties": {"situation": "등록 전 발생한 거래는", "action": "승인 기록과 전달 기록을 함께 확인하여 처리합니다."}}, {"id": "regulation:제8조:5", "label": "Topic", "properties": {"name": "본인 인증과 보안"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제8조:0", "end": "regulation:제8조:1", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제8조:1", "end": "regulation:제8조:2", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제8조:1", "end": "regulation:제8조:3", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제8조:1", "end": "regulation:제8조:4", "properties": {}}, {"type": "ABOUT", "start": "regulation:제8조:1", "end": "regulation:제8조:5", "properties": {}}], "seconds": 5.1}
{"chunk_id": "regulation:제9조", "raw_nodes": ["TermsDocument", "Clause", "Deadline", "Deadline", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_DEADLINE", "SETS_DEADLINE", "ABOUT"], "nodes": [{"id": "regulation:제9조:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제9조:1", "label": "Clause", "properties": {"clause_no": "제9조", "title": "연회비 부과"}}, {"id": "regulation:제9조:2", "label": "Deadline", "properties": {"description": "연회비는 카드 사용 가능일을 기준으로 1년 단위로 청구합니다."}}, {"id": "regulation:제9조:3", "label": "Deadline", "properties": {"description": "장기간 이용하지 않은 카드의 차기 연회비는 청구 전에 회원에게 안내합니다."}}, {"id": "regulation:제9조:4", "label": "Topic", "properties": {"name": "연회비"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제9조:0", "end": "regulation:제9조:1", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제9조:1", "end": "regulation:제9조:2", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제9조:1", "end": "regulation:제9조:3", "properties": {}}, {"type": "ABOUT", "start": "regulation:제9조:1", "end": "regulation:제9조:4", "properties": {}}], "seconds": 2.8}
{"chunk_id": "regulation:제10조", "raw_nodes": ["TermsDocument", "Clause", "Requirement", "Requirement", "Requirement", "Deadline", "Deadline", "Deadline", "Handling", "Handling", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_REQUIREMENT", "SETS_REQUIREMENT", "SETS_REQUIREMENT", "SETS_DEADLINE", "SETS_DEADLINE", "SETS_DEADLINE", "DEFINES_HANDLING", "DEFINES_HANDLING", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제10조:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제10조:1", "label": "Clause", "properties": {"clause_no": "제10조", "title": "연회비 면제 및 계약 해지에 따른 반환"}}, {"id": "regulation:제10조:2", "label": "Requirement", "properties": {"description": "본인회원의 직전 12개월 이용금액이 3,000,000원 이상이고 다음 연회비 청구일까지 연체가 없으면 다음 연도의 기본 연회비를 전액 면제합니다."}}, {"id": "regulation:제10조:3", "label": "Requirement", "properties": {"description": "면제 실적에서는 승인 취소·환불 금액, 세금·공과금, 상품권 구매, 선불 충전, 단기카드대출과 장기카드대출 이용금액을 제외합니다. 선택 서비스 비용은 면제 대상에 포함하지 않습니다."}}, {"id": "regulation:제10조:4", "label": "Requirement", "properties": {"description": "신규 발급에 든 제작·배송비 4,000원과 이미 사용한 선택 서비스의 가상 원가는 반환 기준액에서 뺄 수 있습니다."}}, {"id": "regulation:제10조:5", "label": "Deadline", "properties": {"description": "다음 연회비 청구 전에"}}, {"id": "regulation:제10조:6", "label": "Deadline", "properties": {"description": "7영업일 이내"}}, {"id": "regulation:제10조:7", "label": "Deadline", "properties": {"description": "해지일부터 60일 안에"}}, {"id": "regulation:제10조:8", "label": "Handling", "properties": {"situation": "본인회원의 직전 12개월 이용금액이 3,000,000원 이상이고 다음 연회비 청구일까지 연체가 없으면", "action": "다음 연도의 기본 연회비를 전액 면제합니다."}}, {"id": "regulation:제10조:9", "label": "Handling", "properties": {"situation": "유효기간 전에 계약을 해지면", "action": "해지 다음 날부터 연회비 기간 종료일까지 남은 일수에 비례하여 반환 기준액을 계산합니다."}}, {"id": "regulation:제10조:10", "label": "Handling", "properties": {"situation": "이용내역 조사로 계산이 늦어지면", "action": "지연 사유와 예정일을 알리고 해지일부터 60일 안에 처리합니다."}}, {"id": "regulation:제10조:11", "label": "Topic", "properties": {"name": "연회비"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제10조:0", "end": "regulation:제10조:1", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:2", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:3", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:4", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:5", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:6", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:7", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:8", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:9", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:10", "properties": {}}, {"type": "ABOUT", "start": "regulation:제10조:1", "end": "regulation:제10조:11", "properties": {}}], "seconds": 6.8}
