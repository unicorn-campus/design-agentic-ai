{"chunk_id": "regulation:제16조", "raw_nodes": ["TermsDocument", "Clause", "Deadline", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_DEADLINE", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제16조:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제16조:1", "label": "Clause", "properties": {"clause_no": "제16조", "title": "할부 거래"}}, {"id": "regulation:제16조:2", "label": "Deadline", "properties": {"description": "할부 거래의 개월 수, 회차별 금액과 가상 수수료율은 승인 전에 확인할 수 있도록 표시합니다."}}, {"id": "regulation:제16조:3", "label": "Handling", "properties": {"situation": "일부 회차를 먼저 납부하면", "action": "남은 원금과 다음 청구액을 다시 계산하여 명세서에 표시합니다."}}, {"id": "regulation:제16조:4", "label": "Topic", "properties": {"name": "할부"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제16조:0", "end": "regulation:제16조:1", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제16조:1", "end": "regulation:제16조:2", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조:1", "end": "regulation:제16조:3", "properties": {}}, {"type": "ABOUT", "start": "regulation:제16조:1", "end": "regulation:제16조:4", "properties": {}}], "seconds": 4.9}
{"chunk_id": "regulation:제16조의2", "raw_nodes": ["TermsDocument", "Clause", "Requirement", "Deadline", "Handling", "Handling", "Topic"], "raw_rels": ["HAS_CLAUSE", "SETS_REQUIREMENT", "SETS_DEADLINE", "DEFINES_HANDLING", "DEFINES_HANDLING", "ABOUT"], "nodes": [{"id": "regulation:제16조의2:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제16조의2:1", "label": "Clause", "properties": {"clause_no": "제16조의2", "title": "할부 거래의 철회 요청"}}, {"id": "regulation:제16조의2:2", "label": "Requirement", "properties": {"description": "① 교육용 시나리오에서 정한 철회 가능 거래는 상품을 받은 날 또는 계약서를 받은 날 중 늦은 날부터 7일 이내에 철회를 요청할 수 있습니다."}}, {"id": "regulation:제16조의2:3", "label": "Deadline", "properties": {"description": "상품을 받은 날 또는 계약서를 받은 날 중 늦은 날부터 7일 이내에"}}, {"id": "regulation:제16조의2:4", "label": "Handling", "properties": {"situation": "회원은 가맹점과 카드사에 거래 식별값, 철회 사유와 반환 상태를 제출하며", "action": "카드사는 접수 시각과 처리 단계를 기록합니다."}}, {"id": "regulation:제16조의2:5", "label": "Handling", "properties": {"situation": "이미 사용했거나 가치가 현저히 줄어든 상품 등 철회가 제한되는 경우", "action": "제한 사유와 이의신청 방법을 안내합니다."}}, {"id": "regulation:제16조의2:6", "label": "Topic", "properties": {"name": "할부"}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제16조의2:0", "end": "regulation:제16조의2:1", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:2", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:3", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:4", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:5", "properties": {}}, {"type": "ABOUT", "start": "regulation:제16조의2:1", "end": "regulation:제16조의2:6", "properties": {}}], "seconds": 4.6}
