          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "BenefitExclusion",
      "description": "(\ud61c\ud0dd \uc81c\uc678\uc640 \uc911\ubcf5 \uc81c\ud55c) \ud574\ub2f9: \ud61c\ud0dd\uc5d0\uc11c \ube60\uc9c0\ub294 \uac70\ub798, \ub2e4\ub978 \ud61c\ud0dd\uacfc \ud568\uaed8 \ubc1b\uc744 \uc218 \uc5c6\ub2e4\ub294 \uc81c\ud55c. \ube44\ud574\ub2f9: \ud61c\ud0dd\uc744 \ubc1b\ub294 \uc870\uac74, \ud55c\ub3c4",
      "properties": [
        {
          "name": "description",
