{
  "node_types": [
    {
      "label": "Product",
      "description": "(\uce74\ub4dc \uc0c1\ud488(\uc815\ud615 \ucc38\uc870)) \ud574\ub2f9: \ud55c\ube5b \uce74\ub4dc \uc0c1\ud488 \ud558\ub098. \uc815\ud615 \uc2a4\ud0a4\ub9c8\uc758 Product\ub97c \uac00\ub9ac\ud0a4\ub294 \ucc38\uc870 \ub178\ub4dc. \uc0c1\ub2f4\uc5d0\uc11c\ub294 \uc0c1\ub2f4\uc0ac\ub098 \uace0\uac1d\uc774 '\ud55c\ube5b \u25cb\u25cb \uce74\ub4dc'\ucc98\ub7fc \uc774\ub984\uc744 \ub9d0\ud55c \uce74\ub4dc\uac00 \ubaa8\ub450 \ud574\ub2f9\ud558\uba70, \uc0c1\ub2f4\uc744 \ub9c8\ubb34\ub9ac\ud558\uba70 '\ud55c\ube5b \u25cb\u25cb \uce74\ub4dc \uc0c1\ub2f4\uc73c\ub85c \uae30\ub85d\ud558\uaca0\uc2b5\ub2c8\ub2e4'\ucc98\ub7fc \uae30\ub85d\uc5d0 \ub0a8\uae34\ub2e4\uace0 \ub9d0\ud55c \uce74\ub4dc\ub3c4 \ud574\ub2f9\ud568(\uc774\ub54c Consultation -MENTIONS_PRODUCT-> Product\ub85c \uc774\uc74c). \ube44\ud574\ub2f9: \uc2e4\uc81c \uce74\ub4dc\uc0ac \uc0c1\ud488, \uac1c\ubcc4 \ud61c\ud0dd, \uc5f0\ud68c\ube44\uc640 \uac00\uc871\uce74\ub4dc \uaddc\uce59(\uc815\ud615 \ub370\uc774\ud130\uc5d0 \uc788\uc74c), '\uc774 \uce74\ub4dc', '\ud0c0\uc0ac \uce74\ub4dc'\ucc98\ub7fc \uc774\ub984\uc774 \uc5c6\ub294 \ub9d0",
      "properties": [
        {
          "name": "product_id",
          "type": "STRING",
          "description": "\uc0c1\ud488 ID(\uc608: D2-C001). \ud61c\ud0dd \uc548\ub0b4\ub294 \uba38\ub9ac\uc904 \uac12, \uc0c1\ub2f4\uc740 \uc0c1\ud488 \uc774\ub984\uc73c\ub85c \uc815\ud615 \ub370\uc774\ud130\uc5d0\uc11c \ucc3e\uc74c",
          "required": false
        },
        {
          "name": "product_name",
          "type": "STRING",
          "description": "\uc0c1\ud488 \uc774\ub984(\uc608: \ud55c\ube5b \ubaa8\uc544\uc0dd\ud65c). \uc815\ud615 Product.product_name\uacfc \uac19\uc740 \uae00\uc790",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Benefit",
      "description": "(\ud61c\ud0dd) \ud574\ub2f9: \uce74\ub4dc\uac00 \uc8fc\ub294 \ud61c\ud0dd \ud558\ub098(\ud560\uc778, \uc801\ub9bd, \uce90\uc2dc\ubc31, \ubc14\uc6b0\ucc98, \ub77c\uc6b4\uc9c0 \ub4f1)\uc640 \uadf8 \ud06c\uae30. \ube44\ud574\ub2f9: \ud61c\ud0dd\uc744 \ubc1b\ub294 \uc870\uac74, \ud55c\ub3c4, \uc81c\uc678 \uac70\ub798, \uc5f0\ud68c\ube44",
      "properties": [
        {
          "name": "benefit_id",
          "type": "STRING",
          "description": "\ud61c\ud0ddID. \uba38\ub9ac\uc904 benefit_id \uac12(\uc608: D2-C055-B07). \uc5c6\uc73c\uba74 \ube44\uc6c0",
          "required": false
        },
        {
          "name": "product_id",
          "type": "STRING",
          "description": "\uc0c1\ud488ID. \uba38\ub9ac\uc904 product_id \uac12",
          "required": false
        },
        {
          "name": "name",
          "type": "STRING",
          "description": "\ud61c\ud0dd \uc774\ub984",
          "required": false
        },
        {
          "name": "amount",
          "type": "STRING",
          "description": "\ud61c\ud0dd\uc758 \ud06c\uae30 \ubb38\uc7a5(\uc6d0\ubb38 \uadf8\ub300\ub85c): \uc801\ub9bd\ub960, \ud560\uc778\uc728, \uae08\uc561, \ud69f\uc218. \uc5ec\ub7ec \ud61c\ud0dd\uc744 \ud569\uc0b0\ud55c \uc81c\uacf5 \uc0c1\ud55c\ub9cc \uc801\ud600 \uc788\uc73c\uba74(\uc608: \uc6d4 ~\uc6d0 \uc0c1\ub2f9\uae4c\uc9c0 \uc81c\uacf5) \uadf8 \ubb38\uc7a5\uc744 \uc500. \ud61c\ud0dd \ub178\ub4dc\ub97c \ub9cc\ub4e4\uba74 amount\ub97c \ubc18\ub4dc\uc2dc \ucc44\uc6c0",
          "required": false
        },
        {
          "name": "apply_method",
          "type": "STRING",
          "description": "\ud61c\ud0dd\uc744 \ubc1b\ub294 \ubc29\uc2dd. \ud61c\ud0dd \uc124\uba85\uc5d0 \uc2e0\uccad, \ub4f1\ub85d, \uc751\ubaa8, \uc9c0\uc815, \uc120\ud0dd\ucc98\ub7fc \uace0\uac1d\uc774 \ub530\ub85c \ud574\uc57c \ud558\ub294 \uc77c\uc774 \uc801\ud600 \uc788\uc73c\uba74 '\uc2e0\uccad \ud544\uc694', \uadf8\ub7f0 \ubb38\uad6c\uac00 \uc5c6\uc73c\uba74 '\uc790\ub3d9 \uc801\uc6a9'. '\uc54c \uc218 \uc5c6\uc74c'\uc740 \ud61c\ud0dd \uc124\uba85 \uc790\uccb4\uac00 \uc5c6\uc744 \ub54c\ub9cc \uc500",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "BenefitCondition",
      "description": "(\ud61c\ud0dd \uc870\uac74) \ud574\ub2f9: \ud61c\ud0dd\uc744 \ubc1b\uc73c\ub824\uba74 \ucda9\uc871\ud574\uc57c \ud558\ub294 \uac83(\uc804\uc6d4 \uc774\uc6a9 \uc2e4\uc801, \uc2e0\uccad, \ub300\uc0c1 \uac00\ub9f9\uc810\uc774\ub098 \uc5c5\uc885, \ucc44\ub110). \ube44\ud574\ub2f9: \ud61c\ud0dd \ud06c\uae30, \ud55c\ub3c4, \ubc1b\uc744 \uc218 \uc5c6\ub294 \uac70\ub798",
