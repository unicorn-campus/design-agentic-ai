    {
      "label": "ReconsiderCondition",
      "description": "(\uc7ac\uac80\ud1a0 \uc870\uac74) \ud574\ub2f9: \uace0\uac1d\uc774 \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc0dd\uac01\ud558\uac70\ub098 \ud589\ub3d9\ud558\uaca0\ub2e4\uba70 \ub9d0\ud55c \uc870\uac74. \uc81c\uc548\uc758 \uacb0\uc815(\uc218\uc6a9, \uac70\uc808, \ubcf4\ub958)\uacfc \uc0c1\uad00\uc5c6\uc774, \uace0\uac1d\uc774 '~\ud558\uba74 \ub2e4\uc2dc \uc0dd\uac01\ud560\uac8c\uc694', '~\uba74 \uadf8\ub54c ~\ud560\uac8c\uc694', '~\ub098\uc624\uba74 \ub2e4\uc2dc \ubcfc\uac8c\uc694', '\uadf8\ub798\ub3c4 ~\ud558\uba74 \ub2e4\uc74c\uc5d0 \ubb38\uc758\ud560\uac8c\uc694'\ucc98\ub7fc \ub9d0\ud558\uba74 \ubaa8\ub450 \ud574\ub2f9(\uc608: \ub2e4\uc74c \uba85\uc138\uc11c\ub97c \ubcf4\uace0 \ub2e4\uc2dc \ud310\ub2e8\ud560\uac8c\uc694, \uadf8\ub798\ub3c4 \uc548 \ub9de\uc73c\uba74 \ub2e4\uc74c \uba85\uc138\uc11c \ub098\uc62c \ub54c \ub2e4\uc2dc \ubb38\uc758\ud560\uac8c\uc694, \uc5f0\uacb0\ub41c \uacb0\uc81c \ud655\uc778\uc774 \ub05d\ub098\uba74 \uadf8\ub54c \uc2e0\uccad\ud560\uac8c\uc694). \uadf8 \ub9d0\uc774 \ubd99\uc740 \uc81c\uc548\uc5d0 RECONSIDER_WHEN\uc73c\ub85c \ubd99\uc784. \ube44\ud574\ub2f9: \uc218\uc6a9\ud558\uac70\ub098 \uac70\uc808\ud55c \uc774\uc720 \uc790\uccb4(reason\uc5d0 \uc500), \uc0c1\ub2f4\uc0ac\uc758 \uc548\ub0b4\ub098 \uc9c8\ubb38",
      "properties": [
        {
          "name": "condition",
          "type": "STRING",
          "description": "\uace0\uac1d\uc774 \ub9d0\ud55c \ub2e4\uc2dc \uc0dd\uac01\ud560 \uc870\uac74 \ubb38\uc7a5(\uc6d0\ubb38 \uadf8\ub300\ub85c)",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Topic",
      "description": "(\uc8fc\uc81c) \ud574\ub2f9: \uc870\ud56d\uc774\ub098 \ubd88\ub9cc\uc774 \ub2e4\ub8e8\ub294 \uc5c5\ubb34 \uc8fc\uc81c \ud558\ub098. \uc774\ub984\uc740 \uc544\ub798 \ub300\ud45c \uc774\ub984 \ubaa9\ub85d\uc5d0\uc11c\ub9cc \uace0\ub984(\uac01 \uc774\ub984 \ub4a4\ub294 \ub73b). \ubd88\ub9cc\uc5d0 \ubd99\uc77c \ub54c\ub294 \ubd88\ub9cc\uc758 \uc6d0\uc778\uc774 \ub41c \ub300\uc0c1\uc73c\ub85c \uace0\ub974\uace0, \uc0c1\ub2f4\uc774 \uc77c\uc5b4\ub09c \uc7a5\uba74(\uba85\uc138\uc11c\ub97c \ubcf4\uba70 \ud1b5\ud654, \uc571 \ud654\uba74 \ud655\uc778 \ub4f1)\uc73c\ub85c \uace0\ub974\uc9c0 \uc54a\uc74c(\uc608: \ud61c\ud0dd \uc870\uac74\uc774 \ubd88\ub9cc\uc774\uba74 \uba85\uc138\uc11c\ub97c \ubcf4\uba70 \ub9d0\ud588\uc5b4\ub3c4 '\ubd80\uac00\uc11c\ube44\uc2a4\uc640 \ud3ec\uc778\ud2b8'). \ubaa9\ub85d: \uc5f0\ud68c\ube44: \uc5f0\ud68c\ube44\ub97c \ub9e4\uae30\uace0 \uba74\uc81c\ud558\uac70\ub098 \ub3cc\ub824\uc8fc\ub294 \uc77c; \ubd80\uac00\uc11c\ube44\uc2a4\uc640 \ud3ec\uc778\ud2b8: \ud560\uc778, \uc801\ub9bd, \uce90\uc2dc\ubc31 \uac19\uc740 \ubd80\uac00\uc11c\ube44\uc2a4\uc640 \ud3ec\uc778\ud2b8\ub97c \ubc1b\ub294 \uc870\uac74, \uc2e0\uccad, \uc801\uc6a9 \ub300\uc0c1; \ubcf8\uc778 \uc778\uc99d\uacfc \ubcf4\uc548: \ubcf8\uc778 \ud655\uc778, \uc778\uc99d \uc808\ucc28, \ube44\ubc00\ubc88\ud638, \uce74\ub4dc\uc640 \uc778\uc99d\uc218\ub2e8 \ubcf4\uad00; \ud1b5\uc9c0\uc640 \uad11\uace0: \uce74\ub4dc\uc0ac\uac00 \ud68c\uc6d0\uc5d0\uac8c \uc54c\ub9ac\ub294 \ubc29\ubc95\uacfc \uad11\uace0, \ud310\ucd09 \uc54c\ub9bc; \ubbfc\uc6d0\uacfc \uc774\uc758 \ucc98\ub9ac: \ubbfc\uc6d0, \uc774\uc758\uc2e0\uccad, \ub2e4\ud23c\uc758 \uc811\uc218\uc640 \ucc98\ub9ac \uacbd\uacfc \uc124\uba85; \uba85\uc138\uc11c\uc640 \uacb0\uc81c: \uc774\uc6a9\ub300\uae08 \uba85\uc138\uc11c, \uacb0\uc81c\uc77c\uacfc \ucd9c\uae08, \ub0a9\ubd80, \ucde8\uc18c\uc640 \ud658\ubd88\uc758 \ubc18\uc601; \ud560\ubd80: \ud560\ubd80 \uac70\ub798\uc640 \uadf8 \ucca0\ud68c, \ud56d\ubcc0; \ubd84\uc2e4\uacfc \ubd80\uc815 \uc0ac\uc6a9: \ubd84\uc2e4, \ub3c4\ub09c, \uc758\uc2ec \ubb38\uc790, \ubcf8\uc778\uc774 \ud558\uc9c0 \uc54a\uc740 \uac70\ub798; \uc774\uc6a9\uc815\uc9c0\uc640 \ud734\uba74: \uce74\ub4dc \uc774\uc6a9\uc815\uc9c0\uc640 \ud574\uc81c, \uc624\ub798 \uc4f0\uc9c0 \uc54a\uc740 \uce74\ub4dc; \ud574\uc9c0: \ud68c\uc6d0\uc774\ub098 \uce74\ub4dc\uc0ac\uc758 \uacc4\uc57d \ud574\uc9c0, \ub2e4\ub978 \uce74\ub4dc\uc0ac\ub85c \uc62e\uae30\uae30; \ubc1c\uae09\uacfc \uce74\ub4dc \uad00\ub9ac: \uce74\ub4dc \ubc1c\uae09, \uac00\uc871\uce74\ub4dc, \uc804\ub2ec, \uac31\uc2e0, \uc5ec\ub7ec \uc7a5 \ubcf4\uc720 \uc815\ub9ac; \uac1c\uc778\uc815\ubcf4\uc640 \ud68c\uc6d0 \uc815\ubcf4: \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac, \uc8fc\uc18c\ub098 \uc5f0\ub77d\ucc98 \uac19\uc740 \ud68c\uc6d0 \uc815\ubcf4 \ubcc0\uacbd; \ud574\uc678 \uc774\uc6a9: \ud574\uc678 \uacb0\uc81c\uc640 \ud574\uc678 \uc774\uc6a9 \uc218\uc218\ub8cc, \uc6d0\ud654\uacb0\uc81c; \uce74\ub4dc\ub300\ucd9c\uacfc \uae08\ub9ac: \uce74\ub4dc\ub300\ucd9c, \uc5f0\uccb4, \uae08\ub9ac; \uc774\uc6a9\ud55c\ub3c4\uc640 \uc2b9\uc778: \uc774\uc6a9\ud55c\ub3c4, \uc2b9\uc778\uacfc \ucde8\uc18c\uc758 \uc6d0\uce59. \ube44\ud574\ub2f9: \ubaa9\ub85d\uc5d0 \uc5c6\ub294 \uc774\ub984, \uce74\ub4dc \uc774\ub984, \ud61c\ud0dd \uc774\ub984, \uc5c5\uc885 \uc774\ub984",
      "properties": [
        {
          "name": "name",
          "type": "STRING",
          "description": "\uc8fc\uc81c \ub300\ud45c \uc774\ub984. \ubaa9\ub85d\uc758 \uae00\uc790\ub97c \uadf8\ub300\ub85c \uc500",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "MerchantCategory",
      "description": "(\uc5c5\uc885\uacfc \uacb0\uc81c \ub300\uc0c1) \ud574\ub2f9: \ud61c\ud0dd\uc774 \uc801\uc6a9\ub418\uac70\ub098 \uace0\uac1d\uc774 \ub9d0\ud55c \uacb0\uc81c \ub300\uc0c1 \uc5c5\uc885 \ud558\ub098. \uc774\ub984\uc740 \uc544\ub798 \ub300\ud45c \uc774\ub984 \ubaa9\ub85d\uc5d0\uc11c\ub9cc \uace0\ub984(\uac01 \uc774\ub984 \ub4a4\ub294 \ub73b). \uac00\ub9f9\uc810 \ud55c \uacf3\uc758 \uc774\ub984(\uc608: \uac00\uc0c1 \ud3b8\uc758\uc810 \ud558\ub8e8\uc0c1\uc810)\uc740 \uadf8 \uac00\ub9f9\uc810\uc774 \uc18d\ud55c \uc5c5\uc885 \uc774\ub984\uc73c\ub85c \ubc14\uafd4 \uc500. \ubaa9\ub85d: \uc77c\ubc18 \uac00\ub9f9\uc810: \uc5c5\uc885\uc744 \uac00\ub9ac\uc9c0 \uc54a\ub294 \uad6d\ub0b4 \uc77c\ubc18 \uac00\ub9f9\uc810 \uc804\uccb4; \ud574\uc678 \uacb0\uc81c: \ud574\uc678 \uac00\ub9f9\uc810 \uacb0\uc81c\uc640 \ud574\uc678 \uc6d0\ud654 \ud658\uc0b0 \ub9e4\uc785; \uc7a5\ubcf4\uae30\uc640 \ub9c8\ud2b8: \ub9c8\ud2b8, \uc7a5\ubcf4\uae30, \uc2dd\ub8cc\ud488\uacfc \uc0dd\ud65c\uc6a9\ud488 \uad6c\ub9e4(\ub9e4\uc7a5\uc774\ub4e0 \uc571 \uc8fc\ubb38\uc774\ub4e0); \ud3b8\uc758\uc810: \ud3b8\uc758\uc810; \ucee4\ud53c\uc640 \uc81c\uacfc: \ucee4\ud53c\uc810, \uc81c\uacfc\uc810; \uc74c\uc2dd\uc810\uacfc \ubc30\ub2ec: \uc74c\uc2dd\uc810, \ubc30\ub2ec\uc571 \uc2dd\uc0ac \uc8fc\ubb38; \uc628\ub77c\uc778\uc1fc\ud551: \uc1fc\ud551\ubab0, \uc0dd\ud65c\uc18c\ud488\ubab0, \ubc18\ub824\uc0dd\ud65c\ubab0 \uac19\uc740 \uc628\ub77c\uc778 \uad6c\ub9e4; \uac04\ud3b8\uacb0\uc81c: \uac04\ud3b8\uacb0\uc81c \uc11c\ube44\uc2a4\uc640 \uacb0\uc81c \uc571\uc744 \uac70\uce5c \uacb0\uc81c; \ub300\uc911\uad50\ud1b5\uacfc \ud0dd\uc2dc: \ubc84\uc2a4, \ub3c4\uc2dc\ucca0\ub3c4, \ud0dd\uc2dc, \ucca0\ub3c4 \uc2b9\ucc28\uad8c; \uc8fc\uc720\uc640 \ucda9\uc804: \uc8fc\uc720, \uc804\uae30\ucc28 \ucda9\uc804, \uc218\uc18c \ucda9\uc804; \uc790\ub3d9\ucc28 \uad00\ub9ac\uc640 \uc8fc\ucc28: \uc815\ube44, \uc138\ucc28, \uc8fc\ucc28\uc694\uae08; \ud1b5\uc2e0: \uc774\ub3d9\ud1b5\uc2e0, \ud1b5\uc2e0\uc694\uae08; \uc815\uae30\uacb0\uc81c\uc640 \uad6c\ub3c5: \uc601\uc0c1, \uc74c\uc545 \uac19\uc740 \uad6c\ub3c5\uacfc \uc0dd\ud65c\uc694\uae08, \uad00\ub9ac\ube44, \ub80c\ud0c8, \uba64\ubc84\uc2ed\uc758 \uc6d4 \uc815\uae30\uacb0\uc81c; \ubb38\ud654\uc640 \uc5ec\uac00: \uc601\ud654, \uacf5\uc5f0, \ub180\uc774\uacf5\uc6d0, \uc6b4\ub3d9\uc2dc\uc124, \ucde8\ubbf8 \uc218\uac15\uad8c; \uc5ec\ud589\uacfc \uc219\ubc15: \uacf5\ud56d \ub77c\uc6b4\uc9c0, \uc219\ubc15, \ub9ac\uc870\ud2b8 \uc608\uc57d; \uad50\uc721: \ud559\uc6d0, \uc628\ub77c\uc778 \uac15\uc758 \uc218\uac15\ub8cc; \uc758\ub8cc\uc640 \ub3cc\ubd04: \ubcd1\uc6d0, \uc57d\uad6d, \ub3d9\ubb3c\ubcd1\uc6d0, \ub3cc\ubd04 \uc11c\ube44\uc2a4; \uc0ac\uc5c5\uacbd\ube44: \uc0ac\ubb34\uc6a9\ud488, \ud0dd\ubc30 \uac19\uc740 \uc0ac\uc5c5 \uc6b4\uc601 \uacbd\ube44. \ud61c\ud0dd\uc5d0 \uc787\ub294 \uac83\uc740 \uccad\ud06c\uc5d0 '\ub300\uc0c1', '\ub300\uc0c1\u00b7\ucc44\ub110', '\ub300\uc0c1 \uc601\uc5ed'\ucc98\ub7fc \uc801\uc6a9 \ub300\uc0c1\uc774 \uc801\ud600 \uc788\uc744 \ub54c\ub9cc\uc784. \ud55c\ub3c4, \uc774\uc6a9 \uae30\uc900, \ud1b5\ud569 \ud55c\ub3c4\ub9cc \uc801\ud78c \uccad\ud06c\uc5d0\uc11c\ub294 \uc5c5\uc885\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc74c. \ube44\ud574\ub2f9: \ubaa9\ub85d\uc5d0 \uc5c6\ub294 \uc774\ub984, \uac00\ub9f9\uc810 \uc774\ub984 \uadf8\ub300\ub85c, \ub9e4\uc7a5\uc774\ub098 \uc6b0\ud3b8\ucc98\ub7fc \uacb0\uc81c \ub300\uc0c1\uc774 \uc544\ub2cc \uc7a5\uc18c\ub098 \uc218\ub2e8",
      "properties": [
