185_0000:8", "label": "Clause", "properties": {"clause_no": "제30조", "title": "정지 해제"}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:9", "label": "Clause", "properties": {"clause_no": "제31조", "title": "개인정보 처리"}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:10", "label": "Clause", "properties": {"clause_no": "제32조", "title": "업무 위탁"}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:11", "label": "Handling", "properties": {"situation": "결제금액보다 많이 납부한 금액은", "action": "다음 결제대금과 상계하거나 회원이 지정한 계좌로 돌려줍니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:12", "label": "Handling", "properties": {"situation": "반환 계좌를 확인할 수 없으면", "action": "별도 보관하고 회원에게 확인 방법을 안내합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:13", "label": "Handling", "properties": {"situation": "가맹점 취소가 결제일 전에 접수되면", "action": "해당 명세서에서 차감합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:14", "label": "Handling", "properties": {"situation": "결제일 이후 접수되면", "action": "다음 명세서에서 차감하거나 별도 반환합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:15", "label": "Handling", "properties": {"situation": "일부 취소가 여러 회차의 할부 거래에 연결된 경우", "action": "남은 회차부터 조정합니다. 처리 결과에는 최초 거래와 취소 거래의 식별값을 함께 표시합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:16", "label": "Handling", "properties": {"situation": "회원이 여러 채무를 함께 납부하면", "action": "비용, 지연 금액, 원금의 순서와 거래별 발생 시점을 고려한 교육용 처리 기준을 적용합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:17", "label": "Handling", "properties": {"situation": "회원에게 유리한 별도 처리 요청이 가능한 경우", "action": "신청 방법을 안내하고, 실제 반영 순서를 명세서에 표시합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:18", "label": "Handling", "properties": {"situation": "카드 뒷면 정보나 전체 번호가 촬영·공유된 사실을 알게 되면", "action": "즉시 이용정지와 재발급을 요청합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:19", "label": "Handling", "properties": {"situation": "고의 공유나 카드 양도가 확인된 경우에도", "action": "부정사용 책임은 거래 상황과 안전조치 이행 여부를 함께 검토하여 결정합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:20", "label": "Handling", "properties": {"situation": "회원이 사용하지 않은 거래를 신고하면", "action": "신고 시각, 승인 위치, 인증 기록, 기기 정보 및 배송 기록을 함께 조사합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:21", "label": "Handling", "properties": {"situation": "조사 중에는", "action": "다툼이 있는 금액과 정상 이용금액을 구분하여 표시합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:22", "label": "Handling", "properties": {"situation": "분실, 도난, 반복된 인증 실패, 비정상 위치의 연속 거래 또는 장기 미납이 감지되면", "action": "카드 이용을 임시 정지할 수 있습니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:23", "label": "Handling", "properties": {"situation": "긴급 차단 후에는", "action": "정지 사유, 적용 범위와 확인 절차를 알립니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:24", "label": "Handling", "properties": {"situation": "정지 원인이 해소되고 본인 확인이 끝나면", "action": "이용을 재개할 수 있습니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:25", "label": "Handling", "properties": {"situation": "이용 목적이 끝난 정보는", "action": "교육용 보존기간 표에 따라 삭제하거나 다른 정보와 분리합니다."}}, {"id": "D1_27223010abe31291_81b9432a10cb3185_0000:26", "label": "Handling", "properties": {"situation": "배송, 상담, 전산 운영 등의 업무를 위탁할 때에는", "action": "위탁 목적, 처리 항목과 보유기간을 공개합니다."}}], "rels": [{"type": "HAS_CLAUSE", "start": "D1_27223010abe31291_81b9432a10cb3185_0000:0", "end": "D1_27223010abe31291_81b9432a10cb3185_0000:1", "properties": {}}, {"type": "HAS_CLAUSE", "start": "D1_27223010abe31291_81b9432a10cb3185_0000:0", "end": "D1_27223010abe31291_81b9432a10cb3185_0000:2", "properties": {}}, {"type": "HAS_CLAUSE", "start": "D1_27223010abe31291_81b9432a10cb3185_0000:0", "end": "D1_27223010abe31291_81b9432a10cb3185_0000:3", "properties": {}}, {"type": "HAS_CLAUSE", "start": "D1_27223010abe31291_81b9432a10cb3185_0000:0", "end": "D1_27223010abe31291_81b9432a10cb3185_0000:4", "properties": {}}, {"type": "HAS_CLAUSE", "start": "D1_27223010abe31291_81b9432a10cb3185_0000:0", "end": "D1_27223010abe31291_81b9432a10cb3185_0000:5", "properties": {}}, {"type": "HAS_CLAUSE", "start": "D1_27223010abe31291_81b9432a10cb3185_