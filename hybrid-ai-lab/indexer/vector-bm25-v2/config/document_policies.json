{
  "schema_version": 1,
  "defaults": {
    "chunk_size": 800,
    "chunk_overlap": 200,
    "unit": "embedding_token_including_special_tokens"
  },
  "documents": {
    "D1": {
      "file_regex": "^D1_.*\\.pdf$",
      "doc_type": "regulation",
      "access_level": "public",
      "margin_repeat_min": 2,
      "separators": [
        "(?=제\\s*\\d+조(?:의\\d+)?\\s*\\([^\\n]+\\))",
        "(?<=[.!?。])\\s+",
        "\\n\\n",
        "\\n",
        " ",
        ""
      ]
    },
    "D2": {
      "file_regex": "^D2_.*\\.pdf$",
      "doc_type": "benefit_guide",
      "access_level": "public",
      "margin_repeat_min": 2,
      "separators": [
        "(?=D2-C\\d{3}(?:-B\\d+)?)",
        "(?<=[.!?。])\\s+",
        "\\n\\n",
        "\\n",
        " ",
        ""
      ]
    },
    "D3": {
      "file_regex": "^D3_S\\d{2}_.*\\.txt$",
      "doc_type": "consult_log",
      "access_level": "restricted",
      "separators": [
        "(?=(?:고객|상담사)\\s*[:：])",
        "(?<=[.!?。])\\s+",
        "\\n\\n",
        "\\n",
        " ",
        ""
      ]
    }
  }
}
